# RECLAIM - AI Revenue Recovery Agent
# Production Environment Variables Template for Vercel & Local Development

# ==============================================================================
# 1. UPSTASH REDIS / VERCEL KV (SERVER-SIDE ONLY - CRITICAL PERSISTENCE)
# ==============================================================================
# Upstash Redis REST API credentials for serverless cloud persistence.
# These values MUST remain server-side and NEVER be exposed to the browser.
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# Alternative Vercel KV REST Naming (supported automatically)
# KV_REST_API_URL="https://your-kv-instance.upstash.io"
# KV_REST_API_TOKEN="your_kv_rest_api_token_here"


# ==============================================================================
# 2. RAZORPAY TEST MODE CREDENTIALS (SERVER-SIDE ONLY)
# ==============================================================================
# Razorpay Test Mode API key and webhook secret.
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET MUST remain server-side!
RAZORPAY_KEY_ID="your_razorpay_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"


# ==============================================================================
# 3. GENAI / GEMINI REASONING ENGINE (SERVER-SIDE ONLY - OPTIONAL)
# ==============================================================================
# Gemini API Key for LLM reasoning & intervention explanation.
# Fallback empirical decision engine activates automatically if omitted.
GEMINI_API_KEY="your_gemini_api_key_here"


# ==============================================================================
# 4. SERVER CONFIGURATION (SERVER-SIDE ONLY)
# ==============================================================================
PORT=5000
NODE_ENV="production"


# ==============================================================================
# 5. FRONTEND PUBLIC CONFIGURATION (BROWSER-ACCESSIBLE)
# ==============================================================================
# Base API URL for frontend-v2 Vite build.
# For Vercel monorepo deployment, leave as empty string or "/" for relative API calls.
VITE_API_BASE_URL=""
